{
  "format": "lunalauncher-widget",
  "version": 1,
  "id": "clock.words",
  "name": "Words",
  "name_es": "En palabras",
  "spanX": 5,
  "spanY": 3,
  "padding": 0,
  "tap": "clock",
  "lines": [
    {
      "text": "{time_words:full}",
      "size": 36,
      "font": "sans-serif-light",
      "maxLines": 3
    },
    {
      "text": "{date:EEEE d 'de' MMMM}",
      "text_en": "{date:EEEE, MMMM d}",
      "size": 15,
      "alpha": 0.7,
      "marginTop": 6
    }
  ]
}
